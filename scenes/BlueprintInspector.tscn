[gd_scene load_steps=3 format=3]
[ext_resource type="Script" path="res://scripts/ui/BlueprintInspector.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="InspectorBackground"]
bg_color = Color(0.91, 0.85, 0.72, 1)
content_margin_left = 6.0
content_margin_right = 6.0
content_margin_top = 6.0
content_margin_bottom = 6.0
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

[node name="BlueprintInspector" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="SelectionInfo" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "放置属性 · 仅正放立方体"
autowrap_mode = 2
[node name="PartName" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "选中后可命名方块"

[node name="Tabs" type="TabContainer" parent="."]
layout_mode = 2
theme_override_styles/panel = SubResource("InspectorBackground")
[node name="方块" type="VBoxContainer" parent="Tabs"]
layout_mode = 2
theme_override_constants/separation = 8
[node name="Hint" type="Label" parent="Tabs/方块"]
layout_mode = 2
text = "用正放立方体拼接造型\n边长统一控制长、宽、高"
autowrap_mode = 2
[node name="Anchor" type="OptionButton" parent="Tabs/方块"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "挂点决定方块跟随哪一段身体；更换挂点保持静止人物上的位置。"
[node name="Surface" type="OptionButton" parent="Tabs/方块"]
unique_name_in_owner = true
layout_mode = 2
[node name="EdgeTitle" type="Label" parent="Tabs/方块"]
layout_mode = 2
text = "立方体边长（米）"
[node name="Edge" type="SpinBox" parent="Tabs/方块"]
unique_name_in_owner = true
layout_mode = 2
min_value = 0.005
max_value = 4.0
step = 0.0001
value = 0.13
[node name="ColorTitle" type="Label" parent="Tabs/方块"]
layout_mode = 2
text = "染色（独立于下方物料）"
[node name="Tint" type="ColorPickerButton" parent="Tabs/方块"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
color = Color(0.825, 0.56, 0.384, 1)
edit_alpha = false

[node name="变换" type="VBoxContainer" parent="Tabs"]
layout_mode = 2
theme_override_constants/separation = 8
[node name="PositionTitle" type="Label" parent="Tabs/变换"]
layout_mode = 2
text = "挂点局部位置（米，选中后编辑）"
[node name="Position" type="HBoxContainer" parent="Tabs/变换"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4
[node name="X" type="SpinBox" parent="Tabs/变换/Position"]
layout_mode = 2
size_flags_horizontal = 3
min_value = -64.0
max_value = 64.0
step = 0.0001
prefix = "X"
[node name="Y" type="SpinBox" parent="Tabs/变换/Position"]
layout_mode = 2
size_flags_horizontal = 3
min_value = -64.0
max_value = 64.0
step = 0.0001
prefix = "Y"
[node name="Z" type="SpinBox" parent="Tabs/变换/Position"]
layout_mode = 2
size_flags_horizontal = 3
min_value = -64.0
max_value = 64.0
step = 0.0001
prefix = "Z"
[node name="Hint" type="Label" parent="Tabs/变换"]
layout_mode = 2
text = "方向键：左右/上下移动\nPageUp / PageDown：前后移动\nCtrl+D：复制   Delete：删除"
